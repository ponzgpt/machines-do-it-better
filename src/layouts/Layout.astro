---
// Fonts are self-hosted so a visit makes no third-party request: no cookies, no analytics, no consent banner.
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import { BRAND, OWNER } from '../site';
import { copy, LANGS, pathFor, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  page: '' | 'legal/';
  title: string;
  description: string;
  noindex?: boolean;
}
const { lang, page, title, description, noindex = false } = Astro.props;
const c = copy[lang];
const canonical = new URL(pathFor(lang, page), Astro.site);
const ogImage = new URL(c.og, Astro.site);
const home = page === '' && !noindex;
const link = (hash: string) => (home ? hash : `${pathFor(lang, '')}${hash}`);
---
<!doctype html>
<html lang={c.htmlLang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{noindex ? <meta name="robots" content="noindex"> : (
  <>
    <link rel="canonical" href={canonical}>
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(l, page), Astro.site)}>)}
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor('en', page), Astro.site)}>
  </>
)}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="sitemap" href="/sitemap-index.xml">
<meta name="theme-color" content="#121211">
<meta property="og:type" content="website">
<meta property="og:locale" content={c.ogLocale}>
<meta property="og:site_name" content={`MDIB · ${BRAND}`}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
</head>
<body data-mode="personal">

<header class="top">
  <div class="wrap">
    <a href={home ? '#top' : pathFor(lang, '')} class="brand"><b>MDIB</b><span>Machines Do It Better</span></a>
    <div class="tools">
      <nav class="lang" aria-label={c.nav.lang}>
        {LANGS.map((l) => (
          <a href={pathFor(l, page)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
        ))}
      </nav>
      <button type="button" class="menu-btn" aria-expanded="false" aria-controls="nav">{c.nav.menu}</button>
    </div>
    <nav id="nav" aria-label={c.nav.main}>
      <a href={link('#resultados')}>{c.nav.results}</a>
      <a href={link('#como')}>{c.nav.how}</a>
      <a href={link('#piloto')}>{c.nav.pilot}</a>
      <a href={link('#tecnologia')}>{c.nav.tech}</a>
      <a href={link('#contacto')} class="cta">{c.nav.cta}</a>
    </nav>
  </div>
</header>

<main>
  <slot />
</main>

<footer>
  <div class="wrap">
    <span>© 2026 {BRAND} · {OWNER}</span>
    <span><a href={pathFor(lang, 'legal/')}>{c.footer.legal}</a></span>
  </div>
</footer>

<script>
  // Mobile menu: below 820 px the nav folds behind a button.
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
  const header = document.querySelector('header.top')!;
  const setOpen = (open: boolean) => {
    header.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', String(open));
  };
  btn.addEventListener('click', () => setOpen(!header.classList.contains('open')));
  document.querySelectorAll('#nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
</script>
</body>
</html>

<style is:global>
:root{
  --paper:#F3F2EE; --paper-2:#E8E6DF; --ink:#121211; --ink-2:#2A2A28; --muted:#55544F;
  --line:#D9D7D0; --dark-line:#3A3A37; --dark-muted:#B8B6AE; --dark-text:#D6D4CC;
  --accent:#FF5A1F;
  --display:'Archivo Variable','Archivo',sans-serif; --sans:'IBM Plex Sans',system-ui,sans-serif; --mono:'IBM Plex Mono',monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased}
a{color:var(--ink)} a:hover{color:var(--muted)}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
[id]{scroll-margin-top:16px}
.wrap{max-width:1240px;margin:0 auto;padding-left:24px;padding-right:24px}
.mono{font-family:var(--mono)}
.eyebrow{font-family:var(--mono);font-size:13px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}
.h1{margin:0;font-family:var(--display);font-weight:850;font-stretch:108%;font-size:clamp(44px,6.4vw,92px);line-height:.95;letter-spacing:-.035em}
.h2{margin:0;font-family:var(--display);font-weight:800;font-stretch:105%;font-size:clamp(36px,4.2vw,60px);line-height:1;letter-spacing:-.03em}
.lead{margin:0;font-size:20px;line-height:1.5;max-width:560px;color:var(--ink-2)}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:16px 24px;font-weight:600;font-size:17px;text-decoration:none;border:2px solid var(--ink)}
.btn-accent{background:var(--accent);color:var(--ink)}
.btn-ghost{background:transparent;color:var(--ink);font-weight:500}
.btn-ink{background:var(--ink);color:var(--paper)}
.btn-ink:hover{color:var(--paper);opacity:.9}
.row{display:flex;gap:12px;flex-wrap:wrap}
.nowrap{white-space:nowrap}

/* Nav */
header.top{border-bottom:1px solid var(--line)}
header.top .wrap{padding-top:18px;padding-bottom:18px;display:flex;align-items:center;gap:24px}
.brand{margin-right:auto}
.tools{display:flex;align-items:center;gap:12px;order:2}
#nav{order:1}
.lang{display:flex;border:1px solid var(--ink);font-family:var(--mono);font-size:13px}
.lang a{padding:8px 10px;min-height:36px;display:inline-flex;align-items:center;text-decoration:none;letter-spacing:.06em}
.lang a[aria-current]{background:var(--ink);color:var(--paper)}
.brand{display:flex;align-items:baseline;gap:12px;text-decoration:none;white-space:nowrap}
.brand b{font-family:var(--display);font-weight:900;font-stretch:115%;font-size:24px;letter-spacing:-.02em}
.brand span{font-family:var(--mono);font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
#nav{display:flex;align-items:center;gap:28px;font-size:15px}
#nav a{text-decoration:none;white-space:nowrap}
#nav .cta{background:var(--ink);color:var(--paper);padding:12px 18px;min-height:44px;display:inline-flex;align-items:center;font-weight:500}
#nav .cta:hover{color:var(--paper);opacity:.9}
.menu-btn{display:none;font:inherit;font-family:var(--mono);font-size:14px;text-transform:uppercase;letter-spacing:.08em;min-height:44px;padding:10px 16px;border:2px solid var(--ink);background:transparent;color:var(--ink);cursor:pointer}
@media (max-width:820px){
  header.top .wrap{flex-wrap:wrap;gap:0}
  .menu-btn{display:inline-flex;align-items:center}
  #nav{display:none;flex-basis:100%;order:3;flex-direction:column;align-items:stretch;gap:0;padding-top:16px;font-size:17px}
  #nav a{padding:14px 0;border-top:1px solid var(--line)}
  #nav .cta{justify-content:center;margin-top:12px;padding:14px 18px}
  header.top.open #nav{display:flex}
  .lang a{min-height:44px;padding:8px 12px}
  header.top.open .menu-btn{background:var(--ink);color:var(--paper)}
}
@media (max-width:420px){.brand span{display:none}}

/* Footer */
footer{background:var(--ink);color:var(--dark-muted)}
footer a{color:var(--dark-muted)} footer a:hover{color:var(--paper)}
footer .wrap{padding-top:32px;padding-bottom:32px;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-family:var(--mono);font-size:13px}
</style>
