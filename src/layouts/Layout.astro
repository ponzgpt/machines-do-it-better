---
// Fonts are self-hosted so a visit makes no third-party request: no cookies, no analytics, no consent banner.
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import { BRAND, NEWSLETTER, OWNER } from '../site';
import { copy, LANGS, pathFor, type Lang, type Page } from '../i18n';

interface Props {
  lang: Lang;
  page: Page;
  title: string;
  description: string;
  noindex?: boolean;
}
const { lang, page, title, description, noindex = false } = Astro.props;
const c = copy[lang];
const canonical = new URL(pathFor(lang, page), Astro.site);
const ogImage = new URL(c.og, Astro.site);
const home = page === '' && !noindex;
const link = (hash: string) => (home ? hash : `${pathFor(lang, '')}${hash}`);
---
<!doctype html>
<html lang={c.htmlLang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{noindex ? <meta name="robots" content="noindex"> : (
  <>
    <link rel="canonical" href={canonical}>
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(l, page), Astro.site)}>)}
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor('es', page), Astro.site)}>
  </>
)}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="sitemap" href="/sitemap-index.xml">
<meta name="theme-color" content="#ffffff">
<meta property="og:type" content="website">
<meta property="og:locale" content={c.ogLocale}>
<meta property="og:site_name" content={`MDIB · ${BRAND}`}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
</head>
<body>
<a class="skip" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
<header class="top">
  <div class="wrap bar">
    <a href={home ? '#top' : pathFor(lang, '')} class="brand"><b>MDIB</b><span>Machines Do It Better</span></a>
    <nav class="lang" aria-label={c.nav.lang}>
      {LANGS.map((l) => (
        <a href={pathFor(l, page)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
      ))}
    </nav>
  </div>
  <nav class="tabs" aria-label={c.nav.main}>
    <div class="wrap"><ol>{c.nav.tabs.map(([hash, label], i) => (
      <li><a href={link(hash)}><span class="n">{String(i + 1).padStart(2, '0')}</span>{label}</a></li>
    ))}</ol></div>
  </nav>
</header>

<main id="main">
  <slot />
</main>

<footer>
  <div class="wrap">
    <span>© 2026 {BRAND} · {OWNER}</span>
    <span class="links">
      <a href={NEWSLETTER} target="_blank" rel="noopener">{c.newsletter.link} ↗</a>
      <a href={pathFor(lang, 'legal/')}>{c.footer.legal}</a>
    </span>
  </div>
</footer>
</body>
</html>

<style is:global>
:root{
  --paper:#ffffff; --paper-2:#f4f4f1; --ink:#0b0b0b; --ink-2:#262624; --muted:#5a5a55;
  --line:#dcdcd6; --night:#0e0e0e; --night-line:#2e2e2c; --night-text:#e9e9e4; --night-muted:#a9a9a2;
  --accent:#c83a00;
  --display:'Archivo Variable','Archivo',sans-serif; --sans:'IBM Plex Sans',system-ui,sans-serif; --mono:'IBM Plex Mono',ui-monospace,monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:17px;line-height:1.55;-webkit-font-smoothing:antialiased;overflow-wrap:break-word}
a{color:var(--ink);text-underline-offset:3px}
a:hover{color:var(--accent)}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
[id]{scroll-margin-top:120px}
code{font-family:var(--mono);font-size:.86em;background:var(--paper-2);border:1px solid var(--line);padding:1px 5px;overflow-wrap:anywhere}
.wrap{max-width:1180px;margin:0 auto;padding-left:24px;padding-right:24px}
.skip{position:absolute;left:-9999px;top:8px;background:var(--ink);color:var(--paper);padding:10px 14px;z-index:10}
.skip:focus{left:8px}
.eyebrow{margin:0;font-family:var(--mono);font-size:13px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}
.h1{margin:0;font-family:var(--display);font-weight:900;font-stretch:112%;font-size:clamp(46px,8vw,112px);line-height:.92;letter-spacing:-.04em}
.h2{margin:0;font-family:var(--display);font-weight:850;font-stretch:108%;font-size:clamp(34px,4.6vw,60px);line-height:1;letter-spacing:-.03em}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:14px 22px;font-weight:600;font-size:17px;line-height:1.2;text-decoration:none;border:2px solid var(--ink);text-align:center}
.btn-ink{background:var(--ink);color:var(--paper)}
.btn-ink:hover{background:var(--accent);border-color:var(--accent);color:#fff}
.btn-ghost{background:var(--paper);color:var(--ink)}
.btn-ghost:hover{color:var(--ink);background:var(--paper-2)}
.row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* Header: brand + language, then the guide's section tabs (they scroll sideways on a phone, inside themselves). */
header.top{position:sticky;top:0;z-index:5;background:var(--paper);border-bottom:2px solid var(--ink)}
.bar{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-top:14px;padding-bottom:10px}
.brand{display:flex;align-items:baseline;gap:12px;text-decoration:none;white-space:nowrap}
.brand b{font-family:var(--display);font-weight:900;font-stretch:115%;font-size:24px;letter-spacing:-.02em}
.brand span{font-family:var(--mono);font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
.lang{display:flex;border:2px solid var(--ink);font-family:var(--mono);font-size:13px}
.lang a{padding:6px 10px;min-height:36px;min-width:44px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;letter-spacing:.06em}
.lang a[aria-current]{background:var(--ink);color:var(--paper)}
.tabs{overflow-x:auto;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tabs ol{list-style:none;margin:0;padding:0 0 0;display:flex;gap:4px}
.tabs a{display:inline-flex;align-items:baseline;gap:6px;padding:10px 12px 12px;min-height:44px;white-space:nowrap;text-decoration:none;font-size:15px;font-weight:500;border-bottom:3px solid transparent}
.tabs a:hover{border-bottom-color:var(--accent);color:var(--ink)}
.tabs .n{font-family:var(--mono);font-size:11px;color:var(--muted)}
.tabs li:first-child a{padding-left:0}
@media (max-width:700px){header.top{position:static}[id]{scroll-margin-top:16px}}
@media (max-width:480px){.brand span{display:none}}

footer{border-top:2px solid var(--ink);margin-top:0}
footer .wrap{padding-top:28px;padding-bottom:28px;display:flex;justify-content:space-between;gap:12px 24px;flex-wrap:wrap;font-family:var(--mono);font-size:13px;color:var(--muted)}
footer .links{display:flex;gap:12px 24px;flex-wrap:wrap}
footer a{color:var(--ink)}

@media print{
  header.top{position:static;border-bottom:1px solid #000}
  .tabs,.skip,footer .links a[target]{display:none}
  body{font-size:11pt}
}
</style>
