---
// Fonts are self-hosted so a visit makes no third-party request: no cookies, no analytics, no consent banner.
// Design: a technical dossier, black on white (positioning grill, 2026-11-14): hairline rules, numbered sections,
// monospace labels, one accent used sparingly. The only motion on the site: diagram lines draw on when they
// enter the viewport (see the script at the end), skipped under prefers-reduced-motion and absent without JS.
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import { BRAND, OWNER, OWNER_SITE } from '../site';
import { copy, LANGS, pathFor, type Lang, type Page } from '../i18n';
import NewsletterBlock from '../components/NewsletterBlock.astro';

interface Props {
  lang: Lang;
  page: Page;
  title: string;
  description: string;
  noindex?: boolean;
}
const { lang, page, title, description, noindex = false } = Astro.props;
const c = copy[lang];
const canonical = new URL(pathFor(lang, page), Astro.site);
const ogImage = new URL(c.og, Astro.site);
// The subscribe block closes every page, except the newsletter page (it is that page) and the 404.
const endBlock = !noindex && page !== 'newsletter';
---
<!doctype html>
<html lang={c.htmlLang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{noindex ? <meta name="robots" content="noindex"> : (
  <>
    <link rel="canonical" href={canonical}>
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(l, page), Astro.site)}>)}
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor('es', page), Astro.site)}>
  </>
)}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="sitemap" href="/sitemap-index.xml">
<meta name="theme-color" content="#ffffff">
<meta property="og:type" content="website">
<meta property="og:locale" content={c.ogLocale}>
<meta property="og:site_name" content={`MDIB · ${BRAND}`}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<script is:inline>
  // Arm the draw-on only when it can finish: JS on, motion allowed, IntersectionObserver present.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) document.documentElement.classList.add('draw-on');
</script>
</head>
<body>
<a class="skip" href="#main">{c.skip}</a>
<header class="top">
  <div class="wrap bar">
    <a href={pathFor(lang, 'home')} class="brand" aria-current={page === 'home' && !noindex ? 'page' : undefined}><b>MDIB</b><span>Machines Do It Better</span></a>
    <nav class="tabs" aria-label={c.nav.label}>
      <ol>{c.nav.items.map(([key, label], i) => (
        <li><a href={pathFor(lang, key)} aria-current={key === page ? 'page' : undefined}><span class="n">{String(i + 1).padStart(2, '0')}</span>{label}</a></li>
      ))}</ol>
    </nav>
    <nav class="lang" aria-label={c.nav.lang}>
      {LANGS.map((l) => (
        <a href={pathFor(l, page)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
      ))}
    </nav>
  </div>
</header>

<main id="main">
  <slot />
</main>

{endBlock && <NewsletterBlock lang={lang} access={page === 'home'} />}

<footer>
  <div class="wrap foot">
    <p class="byline">{c.footer.byline} <a href={OWNER_SITE} target="_blank" rel="noopener">{OWNER}<span class="sr-only"> {c.newTab}</span></a>.</p>
    <nav class="links" aria-label={c.footer.nav}>
      {c.nav.items.map(([key, label]) => <a href={pathFor(lang, key)}>{label}</a>)}
      <a href={pathFor(lang, 'legal')}>{c.footer.legal}</a>
    </nav>
    <p class="meta">© 2026 {BRAND} · {c.footer.doc}</p>
  </div>
</footer>
<script>
  // Draw-on: diagram lines ([data-draw] .ln) trace themselves once, when first seen. Lengths are measured here
  // (getTotalLength) rather than with pathLength, which browsers apply to dashes inconsistently. Without the
  // html.draw-on class (JS off, reduced motion) nothing is hidden; CSS also reveals the lines after 3 s if this
  // script never arms them.
  if (document.documentElement.classList.contains('draw-on')) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        e.target.querySelectorAll<SVGGeometryElement>('.ln').forEach((p, i) => {
          p.style.transition = `stroke-dashoffset 1.2s cubic-bezier(.4,0,.2,1) ${p.classList.contains('d3') ? .7 : p.classList.contains('d2') ? .35 : 0}s`;
          p.style.strokeDashoffset = '0';
          p.addEventListener('transitionend', () => { p.style.strokeDasharray = ''; p.style.strokeDashoffset = ''; p.style.transition = ''; }, { once: true });
        });
      }
    }, { threshold: 0.2 });
    document.querySelectorAll<HTMLElement>('[data-draw]').forEach((fig) => {
      fig.querySelectorAll<SVGGeometryElement>('.ln').forEach((p) => {
        const L = Math.ceil(p.getTotalLength()) + 1;
        p.style.strokeDasharray = `${L} ${L}`;
        p.style.strokeDashoffset = String(L);
      });
      fig.classList.add('armed');
      io.observe(fig);
    });
  }
</script>
</body>
</html>

<style is:global>
:root{
  --paper:#ffffff; --paper-2:#f6f6f3; --ink:#111111; --ink-2:#2a2a28; --muted:#55554f;
  --line:#d9d9d4; --hair:#111111;
  --accent:#c83a00;
  --display:'Archivo Variable','Archivo',sans-serif; --sans:'IBM Plex Sans',system-ui,sans-serif; --mono:'IBM Plex Mono',ui-monospace,monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-wrap:break-word}
a{color:var(--ink);text-decoration-thickness:1px;text-underline-offset:3px}
a:hover{color:var(--accent)}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
[id]{scroll-margin-top:96px}
img,svg{max-width:100%}
code{font-family:var(--mono);font-size:.86em;background:var(--paper-2);border:1px solid var(--line);padding:1px 5px;overflow-wrap:anywhere}
.wrap{max-width:1200px;margin:0 auto;padding-left:32px;padding-right:32px}
.skip{position:absolute;left:-9999px;top:8px;background:var(--ink);color:var(--paper);padding:10px 14px;z-index:10}
.skip:focus{left:8px}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* Type: one display face, used at fewer, calmer sizes; labels in mono. */
.eyebrow,.label{margin:0;font-family:var(--mono);font-size:12px;font-weight:500;text-transform:uppercase;letter-spacing:.09em;color:var(--muted)}
.h1{margin:0;font-family:var(--display);font-weight:700;font-stretch:100%;font-size:clamp(38px,5.4vw,72px);line-height:1.02;letter-spacing:-.028em;text-wrap:balance}
.h2{margin:0;font-family:var(--display);font-weight:700;font-stretch:100%;font-size:clamp(28px,3.2vw,42px);line-height:1.08;letter-spacing:-.02em;text-wrap:balance}
.h3{margin:0;font-family:var(--display);font-weight:650;font-size:22px;line-height:1.2;letter-spacing:-.01em}
.lede{margin:16px 0 0;font-size:19px;line-height:1.55;color:var(--ink-2);max-width:680px}
.mono-line{margin:0;font-family:var(--mono);font-size:13px;color:var(--muted)}
.prose p{margin:0 0 16px;font-size:18px;line-height:1.65;max-width:680px}
.rule{width:56px;height:3px;background:var(--accent)}

/* Actions: one primary (ink), at most one quiet secondary (a text link). */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:12px 20px;font-weight:600;font-size:16px;line-height:1.2;text-decoration:none;border:1px solid var(--ink);text-align:center}
.btn-ink{background:var(--ink);color:var(--paper)}
.btn-ink:hover{background:var(--accent);border-color:var(--accent);color:#fff}
.btn-ghost{background:var(--paper);color:var(--ink)}
.btn-ghost:hover{color:var(--ink);background:var(--paper-2)}
.btn[aria-disabled=true]{background:var(--paper-2);color:var(--muted);border-color:var(--line);cursor:not-allowed}
.quiet{font-size:16px;font-weight:500}
.row{display:flex;gap:12px 24px;flex-wrap:wrap;align-items:center}

/* Status marks, from src/catalog.mjs only. */
.badge{display:inline-flex;align-items:center;gap:7px;font-family:var(--mono);font-size:11.5px;font-weight:500;text-transform:uppercase;letter-spacing:.08em;padding:3px 8px;border:1px solid var(--ink);line-height:1.3;white-space:nowrap;vertical-align:middle}
.badge::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor}
.badge[data-status=available]{background:var(--ink);color:var(--paper)}
.badge[data-status=building]{color:var(--accent);border-color:var(--accent)}
.badge[data-status=planned]{color:var(--ink);border-style:dashed}
.badge[data-status=planned]::before{background:transparent;border:1px solid currentColor;width:5px;height:5px}

/* Header */
header.top{position:sticky;top:0;z-index:5;background:var(--paper);border-bottom:1px solid var(--hair)}
.bar{display:flex;align-items:center;gap:12px 28px;min-height:60px}
.brand{display:flex;align-items:baseline;gap:10px;text-decoration:none;white-space:nowrap}
.brand b{font-family:var(--display);font-weight:800;font-size:21px;letter-spacing:-.01em}
.brand span{font-family:var(--mono);font-size:11px;text-transform:uppercase;letter-spacing:.09em;color:var(--muted)}
.tabs{margin-left:auto;overflow-x:auto;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tabs ol{list-style:none;margin:0;padding:0;display:flex;gap:2px}
.tabs a{display:inline-flex;align-items:baseline;gap:6px;padding:10px 10px;min-height:44px;white-space:nowrap;text-decoration:none;font-size:14.5px;font-weight:500;border-bottom:2px solid transparent}
.tabs a:hover{border-bottom-color:var(--accent);color:var(--ink)}
.tabs a[aria-current=page]{border-bottom-color:var(--ink)}
.tabs .n{font-family:var(--mono);font-size:10.5px;color:var(--muted)}
.lang{display:flex;border:1px solid var(--ink);font-family:var(--mono);font-size:12px}
.lang a{padding:4px 8px;min-height:32px;min-width:40px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;letter-spacing:.06em}
.lang a[aria-current]{background:var(--ink);color:var(--paper)}
@media (max-width:900px){
  .bar{flex-wrap:wrap;padding-top:10px}
  .lang{margin-left:auto}
  .tabs{order:3;flex-basis:100%;margin-left:-10px}
  header.top{position:static}
  [id]{scroll-margin-top:16px}
}
@media (max-width:480px){.brand span{display:none}}

/* Dossier sections: a hairline, a number and a label in the margin column, the content on the grid. */
.sec{padding-top:72px;padding-bottom:88px;border-top:1px solid var(--hair)}
.sec-grid{display:grid;grid-template-columns:minmax(0,3fr) minmax(0,9fr);gap:24px 48px}
.sec-mark{display:flex;flex-direction:column;gap:6px;font-family:var(--mono);font-size:12px;text-transform:uppercase;letter-spacing:.09em;color:var(--muted)}
.sec-mark .no{font-size:13px;color:var(--ink);font-weight:500}
.sec-body > .h2 + .lede{margin-top:16px}
@media (max-width:900px){.sec-grid{grid-template-columns:1fr}.sec-mark{flex-direction:row;gap:12px}}
@media (max-width:600px){.sec{padding-top:48px;padding-bottom:56px}.wrap{padding-left:16px;padding-right:16px}}

/* Kept for the guide page: bands, two columns, heads. */
section.band{padding-top:80px;padding-bottom:80px;border-top:1px solid var(--hair)}
section.tint{background:var(--paper)}
.two{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:40px 64px;align-items:start}
.two + .two{margin-top:64px}
.sec-head{display:flex;justify-content:space-between;align-items:end;gap:16px 32px;flex-wrap:wrap;margin-bottom:40px}
.sec-head .lede{margin:0}
@media (max-width:1000px){.two{grid-template-columns:1fr}}
@media (max-width:600px){section.band{padding-top:56px;padding-bottom:56px}}

/* Page heads (manifesto, products, newsletter, guide) */
.hero{border-bottom:1px solid var(--hair)}
.hero-in{padding-top:64px;padding-bottom:64px;display:flex;flex-direction:column;align-items:flex-start;gap:20px}
.hero .h1{max-width:20ch}
.hero .sub{margin:0;font-size:clamp(18px,1.8vw,21px);line-height:1.5;max-width:680px;color:var(--ink-2)}
.facts{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:6px 0;font-family:var(--mono);font-size:13px;color:var(--ink)}
.facts li:not(:last-child)::after{content:"·";margin:0 10px;color:var(--muted)}
.hint{margin:-6px 0 0;font-size:15px;color:var(--muted)}
@media (max-width:600px){.hero-in{padding-top:40px;padding-bottom:44px}}

/* Figures: blueprint line drawings. Strokes in ink, labels in mono, one accent. */
.fig{margin:0;border:1px solid var(--hair);background:var(--paper)}
.fig figcaption{display:flex;justify-content:space-between;gap:12px;padding:10px 14px;border-bottom:1px solid var(--hair);font-family:var(--mono);font-size:11.5px;text-transform:uppercase;letter-spacing:.09em;color:var(--muted)}
.fig svg{display:block;width:100%;height:auto}
.bp{fill:none;stroke:var(--ink);stroke-width:1.25;stroke-linecap:square;stroke-linejoin:miter}
.bp-thin{fill:none;stroke:var(--ink);stroke-width:.75}
.bp-dash{fill:none;stroke:var(--ink);stroke-width:1;stroke-dasharray:4 4}
.bp-acc{fill:none;stroke:var(--accent);stroke-width:2}
.bp-t{font-family:var(--mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;fill:var(--muted)}
.bp-T{font-family:var(--display);font-weight:650;font-size:18px;fill:var(--ink)}
.bp-a{font-family:var(--mono);font-size:12px;fill:var(--accent);letter-spacing:.06em;text-transform:uppercase}
.draw-on [data-draw]:not(.armed) .ln{visibility:hidden;animation:reveal 0s 3s forwards}
@keyframes reveal{to{visibility:visible}}

/* Footer: the byline lives here, and only here (plus the manifesto's closing paragraph). */
footer{border-top:1px solid var(--hair)}
.foot{padding-top:28px;padding-bottom:36px;display:grid;grid-template-columns:1fr auto;gap:12px 24px;font-family:var(--mono);font-size:13px;color:var(--muted)}
.foot p{margin:0}
.foot .byline{color:var(--ink)}
.foot .links{display:flex;gap:10px 22px;flex-wrap:wrap;justify-content:flex-end}
.foot .meta{grid-column:1 / -1}
@media (max-width:700px){.foot{grid-template-columns:1fr}.foot .links{justify-content:flex-start}}

@media print{
  header.top{position:static}
  .tabs,.skip,footer .links,.nl-end{display:none}
  body{font-size:11pt}
}
</style>
