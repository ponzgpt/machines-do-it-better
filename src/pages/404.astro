---
import Layout from '../layouts/Layout.astro';
import { copy } from '../i18n';
const c = copy.es.notFound;
---
<Layout lang="es" page="" title={c.title} description={c.h1} noindex>
<section class="wrap" style="padding-top:96px;padding-bottom:120px;display:flex;flex-direction:column;gap:28px;align-items:flex-start">
  <p class="eyebrow">Error 404</p>
  <h1 class="h1">{c.h1}</h1>
  <p lang="en" style="margin:0;font-size:20px">{copy.en.notFound.h1}</p>
  <div class="row"><a href="/" class="btn btn-ink">{c.back}</a><a href="/en/" class="btn btn-ghost" lang="en">{copy.en.notFound.back}</a></div>
</section>
</Layout>
