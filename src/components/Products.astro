---
// The technical page (/productos/, /en/products/): written for an auditor. For each layer what it is, what it is
// responsible for, what it is made of today (with the evidence path), what it does not do and its status; one
// data-flow figure; then the catalogue with the Stripe-ready buttons (all null today). No marketing adjectives.
import { copy, pathFor, type Lang, type Status } from '../i18n';
import { layers, products, STATUSES } from '../catalog.mjs';
import { guides, fill } from '../guide/render.mjs';
import Badge from './Badge.astro';
import BuyButton from './BuyButton.astro';
import LayersFigure from './LayersFigure.astro';
import RoutingFigure from './RoutingFigure.astro';
import NewsletterBlock from './NewsletterBlock.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const P = c.products;
const g = guides[lang];
const pad = (i: number) => String(i).padStart(2, '0');
---
<section class="hero">
  <div class="wrap hero-in">
    <p class="eyebrow">{P.eyebrow}</p>
    <h1 class="h1">{P.h1}</h1>
    <p class="sub">{P.intro}</p>
    <dl class="legend" aria-label={P.legend}>
      {STATUSES.map((s) => (
        <div><dt><span class="badge" data-status={s}>{c.status[s as Status]}</span></dt><dd>{P.legendText[s as Status]}</dd></div>
      ))}
    </dl>
  </div>
</section>

<section class="sec" aria-labelledby="flow-h">
  <div class="wrap sec-grid">
    <p class="sec-mark"><span class="no">00</span><span>{P.flowLabel}</span></p>
    <div class="sec-body">
      <h2 class="h2" id="flow-h">{P.flowH2}</h2>
      <div class="p-fig"><LayersFigure lang={lang} /></div>
      <ol class="p-flow">{P.flow.map((x) => <li>{x}</li>)}</ol>
      <NewsletterBlock lang={lang} inline={c.letter.inlineProducts} />
    </div>
  </div>
</section>

{layers.map((l, i) => {
  const t = P.layers[l.id];
  return (
    <section class="sec layer" id={l.id} aria-labelledby={`${l.id}-h`}>
      <div class="wrap sec-grid">
        <div class="sec-mark">
          <span class="no">{pad(i + 1)} / 04</span>
          <span><Badge id={l.id} lang={lang} /></span>
        </div>
        <div class="sec-body">
          <h2 class="h2" id={`${l.id}-h`}>{l.name}</h2>
          <p class="lede">{t.descriptor}</p>
          <dl class="sheet">
            <div><dt>{P.whatK}</dt><dd>{t.what}</dd></div>
            <div><dt>{P.jobK}</dt><dd>{t.job}</dd></div>
            <div><dt>{P.todayK}</dt><dd>{t.today}</dd></div>
            <div><dt>{P.filesK}</dt><dd><ul class="files">{t.files.map((f) => <li><code>{f}</code></li>)}</ul></dd></div>
            <div><dt>{P.notK}</dt><dd>{t.not}</dd></div>
          </dl>
          {l.id === 'puente' && <div class="p-fig"><RoutingFigure lang={lang} label={c.home.routing.label.replace('02', '04')} /></div>}
        </div>
      </div>
    </section>
  );
})}

<section class="sec" aria-labelledby="take-h">
  <div class="wrap sec-grid">
    <p class="sec-mark"><span class="no">05</span><span>{P.takeLabel}</span></p>
    <div class="sec-body">
      <h2 class="h2" id="take-h">{P.takeH2}</h2>
      <div class="cards">
        {products.map((p) => {
          const it = P.items[p.id];
          return (
            <article id={`item-${p.id}`}>
              <div class="card-top"><Badge id={p.id} lang={lang} />{it.layer && <span class="mono-line">{it.layer}</span>}</div>
              <h3 class="h3">{it.title}</h3>
              {it.tag && <p class="tag">{it.tag}</p>}
              <p>{fill(it.text, g)}</p>
              {p.free ? (
                <div class="buy">
                  <p class="price">{P.free}</p>
                  <div class="row">
                    <a href={pathFor(lang, 'guide')}>{P.read} <span aria-hidden="true">→</span></a>
                    <a href={g.files.pdf} download>{P.pdf} <span aria-hidden="true">↓</span></a>
                  </div>
                </div>
              ) : (
                <div class="buy"><BuyButton id={p.id} lang={lang} access={p.id === 'private'} /></div>
              )}
            </article>
          );
        })}
      </div>
      <h3 class="h3 how-h">{P.howH2}</h3>
      <p class="how">{P.how}</p>
    </div>
  </div>
</section>

<style>
.legend{margin:4px 0 0;display:flex;flex-direction:column;gap:8px}
.legend div{display:flex;flex-wrap:wrap;align-items:center;gap:6px 14px}
.legend dt{min-width:150px}
.legend dd{margin:0;font-size:15.5px;color:var(--ink-2)}
.p-fig{margin:32px 0 0}
.p-flow{margin:28px 0 0;padding:0 0 0 22px;display:flex;flex-direction:column;gap:10px;font-size:16.5px;max-width:760px}
.p-flow li::marker{font-family:var(--mono);color:var(--accent)}
.sheet{margin:28px 0 0;border-top:1px solid var(--hair)}
.sheet div{display:grid;grid-template-columns:180px minmax(0,1fr);gap:8px 24px;padding:16px 0;border-bottom:1px solid var(--line)}
.sheet dt{font-family:var(--mono);font-size:11.5px;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);padding-top:4px}
.sheet dd{margin:0;font-size:16.5px;line-height:1.6;max-width:720px}
.files{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:6px}
.cards{margin-top:32px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
.cards article{border:1px solid var(--hair);padding:22px;display:flex;flex-direction:column;gap:12px;align-items:flex-start}
.card-top{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center}
.cards p{margin:0;font-size:16px;color:var(--ink-2)}
.cards .tag{font-family:var(--mono);font-size:12.5px;color:var(--ink)}
.buy{margin-top:auto;padding-top:8px;display:flex;flex-direction:column;gap:12px;width:100%}
.cards .price{font-family:var(--mono);font-size:13px;text-transform:uppercase;letter-spacing:.09em;color:var(--ink)}
.how-h{margin-top:48px}
.how{margin:10px 0 0;font-size:16px;color:var(--ink-2);max-width:720px}
@media (max-width:900px){.cards{grid-template-columns:1fr}.sheet div{grid-template-columns:1fr;gap:4px}}
@media (max-width:600px){.legend dt{min-width:140px}.buy .btn{flex:1 1 100%}}
</style>
