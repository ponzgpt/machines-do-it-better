---
// /newsletter/: the newsletter, which is also the access list for the private pilot. What a subscriber gets is
// stated without a sending rhythm: the relaunch format is still being tested (mdib-ops
// strategy/newsletter-relaunch-plan.md), so no cadence is promised here (2026-11-14).
import { copy, type Lang } from '../i18n';
import { NEWSLETTER_ARCHIVE } from '../site';
import SubscribeLink from './SubscribeLink.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const n = c.letter;
---
<section class="hero">
  <div class="wrap hero-in">
    <p class="eyebrow">{n.eyebrow}</p>
    <h1 class="h1">{n.h1}</h1>
    <p class="sub">{n.lede}{n.langNote && <> <strong>{n.langNote}</strong></>}</p>
    <div class="row actions"><SubscribeLink lang={lang} /></div>
    <p class="hint">{n.how}</p>
  </div>
</section>

<section class="sec" aria-labelledby="get-h">
  <div class="wrap sec-grid">
    <p class="sec-mark"><span class="no">01</span><span>{n.eyebrow}</span></p>
    <div class="sec-body">
      <h2 class="h2" id="get-h">{n.getH2}</h2>
      <ul class="nl-get">{n.get.map((x) => <li>{x}</li>)}</ul>
      <p class="state">{n.state}</p>
      <p><a href={NEWSLETTER_ARCHIVE} target="_blank" rel="noopener">{n.archive} <span aria-hidden="true">↗</span><span class="sr-only"> {c.newTab}</span></a></p>
    </div>
  </div>
</section>

<style>
.nl-get{margin:28px 0 28px;padding:0;list-style:none;border-top:1px solid var(--hair)}
.nl-get li{padding:14px 0;border-bottom:1px solid var(--line);font-size:17px;line-height:1.45}
.state{margin:0 0 16px;padding:4px 0 4px 18px;border-left:3px solid var(--accent);font-size:16px;max-width:680px}
@media (max-width:600px){.actions .btn{flex:1 1 100%}}
</style>
