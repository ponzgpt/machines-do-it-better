---
// Fig. 02: cloud/local routing. A task meets your rule; confidential work goes to a model on your machine, the
// rest may go to a cloud model in your name. The plate beside it is the site's one dithered illustration
// (public/plate-machine.png, generated by scripts/build-og.py), shown at its native size so it stays crisp.
import { copy, type Lang } from '../i18n';
import { wrap } from '../lib/wrap';
interface Props { lang: Lang; label?: string }
const { lang, label } = Astro.props;
const r = copy[lang].home.routing;
const m = `arr-r-${lang}`;
---
<figure class="fig routing-fig" data-draw>
  <figcaption><span>{label ?? r.label}</span></figcaption>
  <div class="routing-in">
    <svg viewBox="0 0 560 280" role="img" aria-label={r.aria}>
      <defs>
        <marker id={m} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M0,1 L9,5 L0,9" fill="none" stroke="var(--ink)" stroke-width="1.4" />
        </marker>
      </defs>
      <path class="bp ln" pathLength="1" d="M16,110 H112 V170 H16 Z" />
      <text class="bp-T" x="28" y="146">{r.task}</text>
      <path class="bp ln" pathLength="1" d="M112,140 H174" marker-end={`url(#${m})`} />
      <path class="bp ln d2" pathLength="1" d="M226,88 L278,140 L226,192 L174,140 Z" />
      <text class="bp-T" x="226" y="145" text-anchor="middle" style="font-size:15px">{r.rule}</text>
      <!-- up: cloud -->
      <path class="bp ln d2" pathLength="1" d="M226,88 V56 H342" marker-end={`url(#${m})`} />
      <path class="bp ln d3" pathLength="1" d="M344,26 H544 V90 H344 Z" />
      <text class="bp-T" x="358" y="52">{r.cloud[0]}</text>
      {wrap(r.cloud[1], 26).map((t, i) => <text class="bp-t" x="358" y={72 + i * 14}>{t}</text>)}
      <!-- down: local, inside your machine -->
      <path class="bp ln d2" pathLength="1" d="M226,192 V224 H342" marker-end={`url(#${m})`} />
      <path class="bp-dash ln d3" pathLength="1" d="M332,180 H554 V268 H332 Z" />
      <path class="bp-acc ln d3" pathLength="1" d="M344,192 H544 V256 H344 Z" />
      <text class="bp-T" x="358" y="218">{r.local[0]}</text>
      {wrap(r.local[1], 26).map((t, i) => <text class="bp-a" x="358" y={238 + i * 14}>{t}</text>)}
    </svg>
    <div class="plate">
      <img src="/plate-machine.png" width="240" height="200" alt="" />
      <p class="bp-cap">{r.plate}</p>
    </div>
  </div>
</figure>
<style>
.routing-in{display:grid;grid-template-columns:minmax(0,1fr) 240px;align-items:center;gap:0 24px;padding:8px 16px 8px 8px}
.plate{border-left:1px solid var(--line);padding-left:16px}
.plate img{display:block;width:240px;height:200px;image-rendering:pixelated}
.bp-cap{margin:4px 0 0;font-family:var(--mono);font-size:11.5px;text-transform:uppercase;letter-spacing:.09em;color:var(--muted)}
@media (max-width:760px){
  .routing-in{grid-template-columns:1fr;padding:8px}
  .plate{border-left:0;border-top:1px solid var(--line);padding:12px 0 4px;display:flex;flex-direction:column;align-items:center}
}
</style>
