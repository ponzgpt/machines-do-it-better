---
// The guide page. Everything the reader reads comes from src/guide/<lang>.mjs through render.mjs; only the
// surrounding chrome (downloads, newsletter, illustrative session, diagram) comes from src/i18n.ts.
import { copy, type Lang } from '../i18n';
import { NEWSLETTER } from '../site';
import { guides, facts, factsLine, inline, fill, sourceOf } from '../guide/render.mjs';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const g = guides[lang];
const L = g.labels;
const f = facts(g);
const t = (s: string) => fill(s, g);
const html = (s: string) => inline(s, g);
const [idOutcome, idUse, idMethod, idTools, idNext, idHood, idSources] = c.nav.tabs.map(([h]) => h.slice(1));
const pad = (i: number) => String(i + 1).padStart(2, '0');
---
<!-- HERO -->
<section id="top" class="hero">
  <div class="hero-tex" data-shader aria-hidden="true"></div>
  <div class="wrap hero-in">
    <p class="eyebrow">{c.eyebrow}</p>
    <h1 class="h1">{g.title}</h1>
    <div class="rule" aria-hidden="true"></div>
    <p class="sub">{t(g.subtitle)}</p>
    <ul class="facts" aria-label={c.numbersTitle}>{factsLine(g).map((x) => <li>{x}</li>)}</ul>
    <div class="row actions">
      <a class="btn btn-ink" href={g.files.pdf} download>{c.download.pdf} <span aria-hidden="true">↓</span></a>
      <a class="btn btn-ghost" href={g.files.md} download>{c.download.md} <span aria-hidden="true">↓</span></a>
    </div>
    <p class="hint">{c.download.mdHint}</p>
    <a class="quiet" href={NEWSLETTER} target="_blank" rel="noopener">{c.newsletter.link} <span aria-hidden="true">↗</span><span class="sr-only"> {c.newsletter.newTab}</span></a>
  </div>
</section>

<!-- RESULTADO -->
<section id={idOutcome} class="band">
  <div class="wrap two">
    <h2 class="h2">{L.outcomesTitle}</h2>
    <ol class="outcomes">{g.outcomes.map((o) => <li set:html={html(o)} />)}</ol>
  </div>
  <div class="wrap">
    <h3 class="sr-only">{c.numbersTitle}</h3>
    <dl class="numbers">
      {g.numbers.map((n) => (
        <div><dt>{t(n.value)}</dt><dd>{t(n.label)}{n.note && <small set:html={html(n.note)} />}</dd></div>
      ))}
    </dl>
  </div>
</section>

<!-- COMO USARLA -->
<section id={idUse} class="band tint">
  <div class="wrap two">
    <h2 class="h2">{L.howTitle}</h2>
    <ol class="use">{g.howToUse.map((h) => <li set:html={html(h)} />)}</ol>
  </div>
</section>

<!-- SESION ILUSTRATIVA -->
<section class="night" aria-labelledby="session-h">
  <div class="wrap two">
    <div class="night-copy">
      <p class="eyebrow">{c.session.eyebrow}</p>
      <h2 class="h2" id="session-h">{c.session.h2}</h2>
      <p>{c.session.note}</p>
    </div>
    <figure class="chat" data-replay aria-label={c.session.aria}>
      <figcaption><span>{c.session.head}</span><span class="tag">{c.session.label}</span></figcaption>
      <ol>
        {c.session.lines.map(([who, text]) => (
          <li class={who}>{who !== 'meta' && <b>{who === 'you' ? c.session.you : c.session.agent}</b>}<span data-text>{text}</span></li>
        ))}
      </ol>
      <button type="button" class="replay" hidden>{c.session.replay}</button>
    </figure>
  </div>
</section>

<!-- LO QUE ES TUYO -->
<section class="band" aria-labelledby="owns-h">
  <div class="wrap two">
    <div>
      <p class="eyebrow">{c.owns.eyebrow}</p>
      <h2 class="h2" id="owns-h">{c.owns.h2}</h2>
      <p class="lede">{c.owns.p}</p>
      <dl class="owns">{c.owns.parts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
    </div>
    <svg class="diagram" viewBox="0 0 600 420" role="img" aria-label={c.owns.aria}>
      <defs>
        <filter id="rough" x="-5%" y="-5%" width="110%" height="110%">
          <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="7" />
          <feDisplacementMap in="SourceGraphic" scale="4" />
        </filter>
      </defs>
      <g filter="url(#rough)" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M300 152 C 300 120, 300 100, 300 92" />
        <path d="M262 236 C 230 262, 190 288, 158 304" />
        <path d="M338 236 C 370 262, 410 288, 442 304" />
        <ellipse cx="300" cy="200" rx="96" ry="52" stroke="var(--accent)" stroke-width="4" />
        <rect x="200" y="24" width="200" height="68" rx="4" />
        <rect x="30" y="304" width="200" height="68" rx="4" />
        <rect x="370" y="304" width="200" height="68" rx="4" />
      </g>
      <g font-family="var(--display)" font-weight="800" font-size="30" text-anchor="middle" fill="var(--ink)">
        <text x="300" y="210">{c.owns.center}</text>
        <text x="300" y="68">{c.owns.parts[0][0]}</text>
        <text x="130" y="348">{c.owns.parts[1][0]}</text>
        <text x="470" y="348">{c.owns.parts[2][0]}</text>
      </g>
    </svg>
  </div>
</section>

<!-- METODO -->
<section id={idMethod} class="band tint">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="h2">{L.methodTitle}</h2>
      <p class="mono-line">{f.steps} {L.steps} · {factsLine(g)[2]}</p>
    </div>
    <ol class="progress" aria-hidden="true">{g.steps.map((s, i) => <li><span>{pad(i)}</span>{s.title}</li>)}</ol>
    <div class="steps">
      {g.steps.map((s, i) => (
        <article class="step" id={`${lang === 'es' ? 'paso' : 'step'}-${i + 1}`}>
          <div class="step-n" aria-hidden="true">{pad(i)}</div>
          <div class="step-body">
            <h3><span class="sr-only">{L.step} {i + 1}. </span>{s.title}</h3>
            <dl>
              <dt>{L.do}</dt><dd set:html={html(s.do)} />
              <dt>{L.why}</dt><dd set:html={html(s.why)} />
            </dl>
            <div class="exercise">
              <p class="k">{L.exercise} · {s.exercise.minutes} {L.minutes}</p>
              <p set:html={html(s.exercise.text)} />
            </div>
            <p class="trap"><b>{L.trap}.</b> <span set:html={html(s.trap)} /></p>
            {s.sources.length > 0 && (
              <p class="srcs">{L.sourcesTitle}: {s.sources.map((id: string, j: number) => {
                const src = sourceOf(g, id)!;
                return <>{j > 0 && ' · '}<a href={src.url} target="_blank" rel="noopener">{src.label}</a></>;
              })}</p>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- HERRAMIENTAS -->
<section id={idTools} class="band">
  <div class="wrap">
    <div class="sec-head"><h2 class="h2">{L.toolsTitle}</h2><p class="mono-line">{f.tools} {L.tools}</p></div>
    <div class="tools">
      {g.tools.map((tool) => {
        const src = sourceOf(g, tool.source)!;
        return (
          <article>
            <h3><a href={tool.url} target="_blank" rel="noopener">{tool.name}</a></h3>
            <dl>
              <dt>{L.toolFor}</dt><dd set:html={html(tool.for)} />
              <dt>{L.toolCost}</dt><dd><span set:html={html(tool.cost)} /> <a class="src" href={src.url} target="_blank" rel="noopener">{L.source}</a></dd>
              <dt>{L.toolTrap}</dt><dd set:html={html(tool.trap)} />
            </dl>
          </article>
        );
      })}
    </div>
  </div>
</section>

<!-- DESPUES -->
<section id={idNext} class="band tint">
  <div class="wrap">
    <div class="sec-head"><h2 class="h2">{L.nextTitle}</h2><p class="lede">{g.next.intro}</p></div>
    <div class="ladder">
      {g.next.items.map((it, i) => (
        <article>
          <span class="mono-line">{String.fromCharCode(97 + i)})</span>
          <h3>{it.title}</h3>
          <p>{it.text}</p>
          <a href={NEWSLETTER} target="_blank" rel="noopener">{g.next.cta} <span aria-hidden="true">↗</span><span class="sr-only"> {c.newsletter.newTab}</span></a>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- NEWSLETTER -->
<section class="band ask">
  <div class="wrap">
    <div class="rule" aria-hidden="true"></div>
    <h2 class="h2">{c.newsletter.bandTitle}</h2>
    <p class="lede">{c.newsletter.bandText}</p>
    <div class="row">
      <a class="btn btn-ink" href={NEWSLETTER} target="_blank" rel="noopener">{c.newsletter.bandCta} <span aria-hidden="true">↗</span><span class="sr-only"> {c.newsletter.newTab}</span></a>
      <a class="btn btn-ghost" href={g.files.pdf} download>{c.download.pdf}</a>
      <a class="btn btn-ghost" href={g.files.md} download>{c.download.md}</a>
    </div>
  </div>
</section>

<!-- CAPO, AVISO, FUENTES -->
<section id={idHood} class="band tint">
  <div class="wrap two">
    <h2 class="h2">{L.hoodTitle}</h2>
    <div class="prose">{g.hood.map((p) => <p set:html={html(p)} />)}</div>
  </div>
</section>
<section class="band" aria-labelledby="notice-h">
  <div class="wrap two">
    <h2 class="h2" id="notice-h">{L.noticeTitle}</h2>
    <div class="prose">{g.notice.map((p) => <p set:html={html(p)} />)}</div>
  </div>
  <div class="wrap two" id={idSources}>
    <h2 class="h2">{L.sourcesTitle}</h2>
    <div class="prose">
      <p>{L.sourcesNote}</p>
      <ol class="sources">{g.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a> <span class="url">{s.url.replace(/^https:\/\//, '')}</span></li>)}</ol>
    </div>
  </div>
</section>

<script>
  import { mountHeroShader } from '../scripts/hero-shader';
  import { mountReplay } from '../scripts/replay';
  mountHeroShader(document.querySelector<HTMLElement>('[data-shader]'));
  mountReplay(document.querySelector<HTMLElement>('[data-replay]'));
</script>

<style is:global>
section.band{padding-top:96px;padding-bottom:96px}
section.tint{background:var(--paper-2);border-top:2px solid var(--ink);border-bottom:2px solid var(--ink)}
section.tint + section.tint{border-top:0}
.two{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:48px 64px;align-items:start}
.two + .two{margin-top:72px}
.lede{margin:20px 0 0;font-size:19px;line-height:1.55;color:var(--ink-2);max-width:620px}
.mono-line{margin:0;font-family:var(--mono);font-size:14px;color:var(--muted)}
.sec-head{display:flex;justify-content:space-between;align-items:end;gap:16px 32px;flex-wrap:wrap;margin-bottom:48px}
.sec-head .lede{margin:0}
.rule{width:120px;height:10px;background:var(--accent)}

/* Hero */
.hero{position:relative;overflow:hidden;border-bottom:2px solid var(--ink)}
.hero-tex{position:absolute;inset:0;z-index:0;opacity:1;
  background-image:radial-gradient(circle at center,#e3e3de 1.2px,transparent 1.6px);background-size:9px 9px;
  -webkit-mask-image:linear-gradient(100deg,transparent 38%,#000 85%);mask-image:linear-gradient(100deg,transparent 38%,#000 85%)}
.hero-tex canvas{display:block;width:100%;height:100%}
.hero-tex.has-gl{background-image:none;opacity:.22}
.hero-in{position:relative;z-index:1;padding-top:72px;padding-bottom:80px;display:flex;flex-direction:column;align-items:flex-start;gap:24px}
.hero .h1{max-width:11ch}
.hero .sub{margin:0;font-size:clamp(19px,2vw,23px);line-height:1.45;max-width:640px;color:var(--ink-2)}
.facts{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:6px 0;font-family:var(--mono);font-size:14px;color:var(--ink)}
.facts li:not(:last-child)::after{content:"·";margin:0 10px;color:var(--muted)}
.actions{margin-top:8px}
.hint{margin:-8px 0 0;font-size:15px;color:var(--muted)}
.quiet{font-size:16px;font-weight:500}

/* Outcomes + numbers */
.outcomes,.use{margin:0;padding:0;list-style:none;counter-reset:o;display:flex;flex-direction:column;gap:0;border-top:2px solid var(--ink)}
.outcomes li,.use li{counter-increment:o;display:grid;grid-template-columns:48px 1fr;gap:12px;padding:18px 0;border-bottom:1px solid var(--line);font-size:19px;line-height:1.45}
.outcomes li::before,.use li::before{content:counter(o,decimal-leading-zero);font-family:var(--mono);font-size:14px;color:var(--accent);padding-top:5px}
.numbers{margin:72px 0 0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:2px solid var(--ink)}
.numbers div{padding:28px 24px 8px 0;border-right:1px solid var(--line)}
.numbers div + div{padding-left:24px}
.numbers div:last-child{border-right:0}
.numbers dt{white-space:nowrap;font-family:var(--display);font-weight:900;font-stretch:110%;font-size:clamp(48px,4.8vw,76px);line-height:1;letter-spacing:-.04em}
.numbers div:first-child dt{color:var(--accent)}
.numbers dd{margin:12px 0 0;font-size:16px;line-height:1.45}
.numbers small{display:block;margin-top:10px;font-size:13.5px;line-height:1.5;color:var(--muted)}

/* Illustrative session: the only dark block */
.night{background:var(--night);color:var(--night-text);padding-top:96px;padding-bottom:96px}
.night .eyebrow{color:var(--night-muted)}
.night-copy{display:flex;flex-direction:column;gap:20px}
.night-copy p:last-child{margin:0;color:var(--night-muted);font-size:16px;max-width:420px}
.chat{margin:0;border:1px solid var(--night-line);font-family:var(--mono);font-size:14.5px;line-height:1.55;position:relative}
.chat figcaption{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:14px 18px;border-bottom:1px solid var(--night-line);font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--night-muted)}
.chat .tag{color:var(--night-text);border:1px solid var(--night-text);padding:1px 6px}
.chat ol{list-style:none;margin:0;padding:10px 18px 18px}
.chat li{display:grid;grid-template-columns:64px minmax(0,1fr);gap:12px;padding:8px 0}
.chat li b{font-weight:500;color:var(--night-muted)}
.chat li.you span{color:#fff}
.chat li.agent b{color:#fff}
.chat li.meta{grid-template-columns:1fr;text-align:center;color:var(--night-muted);font-size:12px;letter-spacing:.08em;text-transform:uppercase;padding:14px 0 4px;border-top:1px dashed var(--night-line);margin-top:6px}
.chat li.pending{visibility:hidden}
.chat .rest{visibility:hidden}
.chat .caret{display:inline-block;width:.6em;height:1.1em;vertical-align:text-bottom;background:var(--night-text);margin-left:1px}
.replay{position:absolute;right:12px;bottom:12px;font:inherit;font-size:12px;text-transform:uppercase;letter-spacing:.08em;background:transparent;color:var(--night-text);border:1px solid var(--night-text);padding:6px 10px;min-height:36px;cursor:pointer}
.replay:hover{background:var(--night-text);color:var(--night)}

/* What is yours */
.owns{margin:32px 0 0;border-top:2px solid var(--ink)}
.owns div{display:grid;grid-template-columns:140px 1fr;gap:12px;padding:14px 0;border-bottom:1px solid var(--line)}
.owns dt{font-weight:600}
.owns dd{margin:0;color:var(--ink-2)}
.diagram{width:100%;height:auto;max-width:600px;justify-self:center}

/* Method */
.progress{list-style:none;margin:0 0 56px;padding:0;display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:4px;font-size:13px;line-height:1.3}
.progress li{border-top:6px solid var(--ink);padding-top:10px;color:var(--ink-2)}
.progress span{display:block;font-family:var(--mono);color:var(--muted);margin-bottom:2px}
.steps{display:flex;flex-direction:column}
.step{display:grid;grid-template-columns:180px minmax(0,1fr);gap:24px 40px;padding:48px 0;border-top:2px solid var(--ink)}
.step-n{font-family:var(--display);font-weight:900;font-stretch:110%;font-size:clamp(72px,9vw,128px);line-height:.85;letter-spacing:-.05em}
.step h3{margin:0 0 20px;font-family:var(--display);font-weight:850;font-stretch:105%;font-size:clamp(28px,3vw,40px);line-height:1.05;letter-spacing:-.02em}
.step dl{margin:0;display:grid;grid-template-columns:120px minmax(0,1fr);gap:12px 20px}
.step dt{font-family:var(--mono);font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);padding-top:4px}
.step dd{margin:0;font-size:17px;line-height:1.6;max-width:720px}
.exercise{margin:28px 0 0;padding:20px 24px;background:var(--paper);border:2px solid var(--ink);border-left:10px solid var(--accent);max-width:840px}
.exercise .k{margin:0 0 6px;font-family:var(--mono);font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:var(--accent);font-weight:500}
.exercise p:last-child{margin:0;font-size:17px}
.trap{margin:20px 0 0;max-width:840px;font-size:16px;color:var(--ink-2)}
.srcs{margin:16px 0 0;font-size:13.5px;color:var(--muted)}
.srcs a{color:var(--muted)}

/* Tools */
.tools{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(340px,100%),1fr));border-top:2px solid var(--ink);border-left:1px solid var(--line)}
.tools article{padding:28px 24px 32px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
.tools h3{margin:0 0 16px;font-family:var(--display);font-weight:800;font-size:24px;letter-spacing:-.01em}
.tools h3 a{text-decoration:none}
.tools dl{margin:0}
.tools dt{font-family:var(--mono);font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-top:12px}
.tools dd{margin:4px 0 0;font-size:16px;line-height:1.5}
.tools .src{font-family:var(--mono);font-size:12px;color:var(--muted)}

/* Ladder */
.ladder{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
.ladder article{background:var(--paper);border:2px solid var(--ink);padding:32px;display:flex;flex-direction:column;gap:12px;align-items:flex-start}
.ladder h3{margin:0;font-family:var(--display);font-weight:850;font-size:30px;letter-spacing:-.02em;line-height:1.05}
.ladder p{margin:0;font-size:17px;color:var(--ink-2)}
.ladder a{margin-top:auto;padding-top:8px;font-weight:600}

.ask .wrap{display:flex;flex-direction:column;gap:24px;align-items:flex-start}
.ask .h2{max-width:900px}
.ask .lede{margin:0}

.prose p{margin:0 0 16px;font-size:18px;line-height:1.6;max-width:680px}
.sources{margin:0;padding-left:22px;display:flex;flex-direction:column;gap:8px;font-size:16px}
.sources .url{display:block;font-family:var(--mono);font-size:12.5px;color:var(--muted);overflow-wrap:anywhere}

@media (max-width:1000px){
  .two{grid-template-columns:1fr}
  .numbers{grid-template-columns:repeat(2,minmax(0,1fr))}
  .numbers div:nth-child(2){border-right:0}
  .numbers div:nth-child(3){padding-left:0}
  .progress{grid-template-columns:repeat(4,minmax(0,1fr));row-gap:16px}
  .step{grid-template-columns:1fr}
}
@media (max-width:600px){
  section.band,.night{padding-top:64px;padding-bottom:64px}
  .hero-in{padding-top:48px;padding-bottom:56px;gap:20px}
  .numbers{grid-template-columns:1fr}
  .numbers div,.numbers div + div{padding:24px 0 16px;border-right:0;border-bottom:1px solid var(--line)}
  .progress{display:none}
  .step{padding:40px 0}
  .step dl{grid-template-columns:1fr;gap:4px}
  .step dd{margin-bottom:12px}
  .exercise{padding:16px 18px}
  .ladder{grid-template-columns:1fr}
  .ladder article{padding:24px}
  .actions .btn,.ask .btn{flex:1 1 100%}
  .chat{font-size:13.5px}
  .chat li{grid-template-columns:52px minmax(0,1fr);gap:8px}
  .owns div{grid-template-columns:1fr;gap:2px}
  .outcomes li,.use li{font-size:17px;grid-template-columns:36px 1fr}
}
@media print{
  .hero-tex,.actions,.hint,.quiet,.replay,.ask,.ladder a{display:none !important}
  .night{background:#fff;color:#000}
  .chat,.chat figcaption{border-color:#000;color:#000}
  .chat li span,.chat li b{color:#000 !important}
  .chat li.pending,.chat .rest{visibility:visible}
  section.band,.night{padding-top:24px;padding-bottom:24px}
  .step{break-inside:avoid}
  .tools article{break-inside:avoid}
}
</style>
