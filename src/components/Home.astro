---
// The home page: the ethos, one idea per screen. Copy in src/i18n.ts, statuses in src/catalog.mjs.
import { copy, pathFor, type Lang } from '../i18n';
import { layers } from '../catalog.mjs';
import { OWNER_SITE } from '../site';
import { guides, fill } from '../guide/render.mjs';
import Badge from './Badge.astro';
import OwnsDiagram from './OwnsDiagram.astro';
import NewsletterBlock from './NewsletterBlock.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const h = c.home;
const g = guides[lang];
const pad = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="hero home-hero">
  <div class="hero-tex" data-shader aria-hidden="true"></div>
  <div class="wrap hero-in">
    <p class="eyebrow">{h.eyebrow}</p>
    <h1 class="h1 mega">{h.h1.split(/(?<=\.)\s+/).map((x) => <span>{x} </span>)}</h1>
    <div class="rule" aria-hidden="true"></div>
    <p class="sub">{h.sub}</p>
    <div class="row actions">
      <a class="btn btn-ink" href={pathFor(lang, 'products')}>{h.ctaProducts} <span aria-hidden="true">→</span></a>
      <a class="btn btn-ghost" href={pathFor(lang, 'manifesto')}>{h.ctaManifesto}</a>
    </div>
    <a class="quiet" href={pathFor(lang, 'newsletter')}>{h.ctaNewsletter} <span aria-hidden="true">→</span></a>
  </div>
</section>

<h2 class="sr-only">{h.pillarsLabel}</h2>
{h.pillars.map((p, i) => (
  <section class:list={['pillar', i % 2 === 1 && 'tint']} aria-labelledby={`pillar-${i + 1}`}>
    <div class:list={['wrap', i >= 3 ? 'two pillar-two' : 'pillar-one']}>
      <div>
        <p class="pillar-k"><span class="pillar-n" aria-hidden="true">{pad(i)}</span>{p.kicker}</p>
        <h3 class="h2 pillar-h" id={`pillar-${i + 1}`}>{p.statement}</h3>
        <p class="lede">{p.body}</p>
        {i === 3 && <dl class="owns">{c.owns.parts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>}
      </div>
      {i === 3 && <OwnsDiagram lang={lang} />}
      {i === 4 && (
        <figure class="hybrid" aria-label={h.hybrid.aria}>
          <div class="hy-col">
            <p class="hy-h">{h.hybrid.cloud[0]}</p>
            <ul>{h.hybrid.cloud[1].map((x) => <li>{x}</li>)}</ul>
          </div>
          <div class="hy-you">
            <p class="hy-h">{h.hybrid.you[0]}</p>
            <p>{h.hybrid.you[1]}</p>
          </div>
          <div class="hy-col">
            <p class="hy-h">{h.hybrid.local[0]}</p>
            <ul>{h.hybrid.local[1].map((x) => <li>{x}</li>)}</ul>
          </div>
        </figure>
      )}
    </div>
  </section>
))}

<section class="band family" aria-labelledby="family-h">
  <div class="wrap">
    <div class="sec-head">
      <div><p class="eyebrow">{h.familyEyebrow}</p><h2 class="h2" id="family-h">{h.familyH2}</h2></div>
      <a href={pathFor(lang, 'products')}>{h.familyMore} <span aria-hidden="true">→</span></a>
    </div>
    <ul class="grid4">
      {layers.map((l) => (
        <li>
          <a href={`${pathFor(lang, 'products')}#${l.id}`}>
            <span class="layer-name">{l.name}</span>
            <span class="layer-d">{c.products.layers[l.id].descriptor}</span>
          </a>
          <Badge id={l.id} lang={lang} />
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="band tint" aria-labelledby="start-h">
  <div class="wrap two">
    <div>
      <p class="eyebrow">{h.startEyebrow}</p>
      <h2 class="h2" id="start-h">{h.startH2}</h2>
    </div>
    <div class="start">
      <p class="start-title">{g.title} <Badge id="guide" lang={lang} /></p>
      <p class="lede">{fill(h.startText, g)}</p>
      <div class="row">
        <a class="btn btn-ink" href={pathFor(lang, 'guide')}>{h.startRead} <span aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href={g.files.pdf} download>{c.download.pdf} <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </div>
</section>

<NewsletterBlock lang={lang} />

<section class="band tint" aria-labelledby="who-h">
  <div class="wrap two">
    <div><p class="eyebrow">{h.whoEyebrow}</p><h2 class="h2" id="who-h">{h.whoH2}</h2></div>
    <div class="prose">
      {h.whoText.map((p) => <p>{p}</p>)}
      <p><a href={OWNER_SITE} target="_blank" rel="noopener">{h.whoLink} <span aria-hidden="true">↗</span><span class="sr-only"> {c.newTab}</span></a></p>
    </div>
  </div>
</section>

<script>
  import { mountHeroShader } from '../scripts/hero-shader';
  mountHeroShader(document.querySelector<HTMLElement>('[data-shader]'));
</script>

<style>
.home-hero .hero-in{padding-top:96px;padding-bottom:112px}
.mega{font-size:clamp(52px,10vw,148px);max-width:12ch}
.home-hero .h1{max-width:none}
.mega span{display:block}

/* One idea per screen */
.pillar{min-height:82vh;display:flex;align-items:center;padding:96px 0;border-bottom:2px solid var(--ink)}
.pillar.tint{background:var(--paper-2)}
.pillar > .wrap{width:100%}
.pillar-two{align-items:center}
.pillar-k{margin:0 0 24px;display:flex;align-items:baseline;gap:16px;font-family:var(--mono);font-size:14px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}
.pillar-n{font-family:var(--display);font-weight:900;font-size:22px;letter-spacing:0;color:var(--accent)}
.pillar-h{font-size:clamp(40px,7vw,96px);line-height:.95;letter-spacing:-.04em;max-width:14ch}
.pillar-one .lede{font-size:clamp(19px,1.8vw,23px);max-width:680px;margin-top:32px}
.pillar-two .pillar-h{font-size:clamp(40px,5.4vw,76px)}
.owns{margin:32px 0 0;border-top:2px solid var(--ink)}
.owns div{display:grid;grid-template-columns:140px 1fr;gap:12px;padding:14px 0;border-bottom:1px solid var(--line)}
.owns dt{font-weight:600}
.owns dd{margin:0;color:var(--ink-2)}

/* Hybrid diagram: plain HTML so it reads, translates and reflows */
.hybrid{margin:0;display:grid;grid-template-columns:1fr;gap:0;border:2px solid var(--ink);background:var(--paper)}
.hy-col,.hy-you{padding:20px 24px}
.hy-col + .hy-you,.hy-you + .hy-col{border-top:2px solid var(--ink)}
.hy-h{margin:0 0 8px;font-family:var(--mono);font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
.hy-col ul{margin:0;padding:0 0 0 18px;font-size:17px;line-height:1.5}
.hy-col li + li{margin-top:4px}
.hy-you{background:var(--ink);color:var(--paper)}
.hy-you .hy-h{color:#c9c9c2}
.hy-you p:last-child{margin:0;font-family:var(--display);font-weight:800;font-size:24px;line-height:1.15}

/* Product family */
.family .sec-head a{font-weight:600}
.grid4{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:2px solid var(--ink);border-left:1px solid var(--line)}
.grid4 li{display:flex;flex-direction:column;align-items:flex-start;gap:20px;padding:28px 24px 32px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
.grid4 a{display:flex;flex-direction:column;gap:12px;text-decoration:none}
.layer-name{font-family:var(--display);font-weight:900;font-stretch:110%;font-size:clamp(36px,3.6vw,52px);line-height:1;letter-spacing:-.03em}
.grid4 a:hover .layer-name{color:var(--accent)}
.layer-d{font-size:16px;line-height:1.5;color:var(--ink-2)}

.start-title{margin:0;display:flex;flex-wrap:wrap;align-items:center;gap:12px 16px;font-family:var(--display);font-weight:850;font-size:clamp(26px,3vw,36px);line-height:1.05;letter-spacing:-.02em}
.start .lede{margin:16px 0 24px}

@media (max-width:1000px){
  .grid4{grid-template-columns:repeat(2,minmax(0,1fr))}
  .pillar{min-height:0}
}
@media (max-width:600px){
  .home-hero .hero-in{padding-top:56px;padding-bottom:64px}
  .pillar{padding:72px 0}
  .grid4{grid-template-columns:1fr}
  .owns div{grid-template-columns:1fr;gap:2px}
  .actions .btn{flex:1 1 100%}
}
</style>
