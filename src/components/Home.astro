---
// The home page, in the order decided on 2026-11-14: hero (problem first), what you get, how it works, the two
// doors, the layers for whoever wants to look, then the subscribe block (rendered by the layout).
// Copy in src/i18n.ts, statuses in src/catalog.mjs.
import { copy, pathFor, type Lang, type Who } from '../i18n';
import { layers, steps } from '../catalog.mjs';
import { guides, fill } from '../guide/render.mjs';
import Badge from './Badge.astro';
import SubscribeLink from './SubscribeLink.astro';
import NewsletterBlock from './NewsletterBlock.astro';
import HeroFigure from './HeroFigure.astro';
import RoutingFigure from './RoutingFigure.astro';
import LayersFigure from './LayersFigure.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const h = c.home;
const g = guides[lang];
const pad = (i: number) => String(i + 1).padStart(2, '0');
const howId = lang === 'es' ? 'como-funciona' : 'how-it-works';
---
<section class="home-hero">
  <div class="wrap hero-grid">
    <div class="hero-text">
      <p class="label">{h.kicker}</p>
      <h1 class="h1">{h.h1}</h1>
      <p class="sub">{h.sub}</p>
      <dl class="spec">
        {h.spec.map(([k, v], i) => (
          <div><dt>{k}</dt><dd>{i === 2 ? <><Badge id="private" lang={lang} /> {v}</> : v}</dd></div>
        ))}
      </dl>
      <div class="row hero-cta">
        <SubscribeLink lang={lang} access />
        <a class="quiet" href={`#${howId}`}>{h.how} <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <HeroFigure lang={lang} />
  </div>
</section>

<section class="sec" aria-labelledby="get-h">
  <div class="wrap sec-grid">
    <p class="sec-mark"><span class="no">01</span><span>{h.getLabel}</span></p>
    <div class="sec-body">
      <h2 class="h2" id="get-h">{h.getH2}</h2>
      <ol class="get">
        {h.get.map((it, i) => (
          <li>
            <div class="get-head">
              <p class="label"><span class="acc">{pad(i)}</span> · {it.k}</p>
              <h3 class="h3">{it.statement}</h3>
            </div>
            <div class="get-body">
              <p>{it.body}</p>
              <p class="example"><span class="label">{c.illustrative}</span>{it.example}</p>
            </div>
          </li>
        ))}
      </ol>
      <RoutingFigure lang={lang} />
      <NewsletterBlock lang={lang} access inline={h.inline} />
    </div>
  </div>
</section>

<section class="sec" id={howId} aria-labelledby="how-h">
  <div class="wrap sec-grid">
    <p class="sec-mark"><span class="no">02</span><span>{h.howLabel}</span></p>
    <div class="sec-body">
      <h2 class="h2" id="how-h">{h.howH2}</h2>
      <p class="lede">{h.howIntro}</p>
      <ol class="flow">
        {steps.map((s, i) => (
          <li>
            <span class="flow-n" aria-hidden="true">{pad(i)}</span>
            <div><h3 class="h3">{h.steps[s.id].title}</h3><p>{h.steps[s.id].text}</p></div>
            <dl class="flow-meta">
              <div><dt>{c.whoLabel}</dt><dd>{c.who[s.who as Who]}</dd></div>
              <div><dt class="sr-only">{h.spec[2][0]}</dt><dd><Badge id={s.id} lang={lang} /></dd></div>
            </dl>
          </li>
        ))}
      </ol>
      <p class="today">{h.today}</p>
    </div>
  </div>
</section>

<section class="sec" aria-labelledby="doors-h">
  <div class="wrap sec-grid">
    <p class="sec-mark"><span class="no">03</span><span>{h.doorsLabel}</span></p>
    <div class="sec-body">
      <h2 class="h2" id="doors-h">{h.doorsH2}</h2>
      <div class="doors">
        <article class="door door-made">
          <p class="label">A · {h.made.k}</p>
          <h3 class="h3">{h.made.title}</h3>
          <p class="door-status"><Badge id="private" lang={lang} /> {h.made.status}</p>
          <p>{h.made.text}</p>
          <SubscribeLink lang={lang} access />
        </article>
        <article class="door">
          <p class="label">B · {h.diy.k}</p>
          <h3 class="h3">{h.diy.title}</h3>
          <p class="door-status"><Badge id="guide" lang={lang} /> {g.title}</p>
          <p>{fill(h.diy.text, g)}</p>
          <a class="quiet" href={pathFor(lang, 'guide')}>{h.diy.cta} <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>
  </div>
</section>

<section class="sec" aria-labelledby="inside-h">
  <div class="wrap sec-grid">
    <p class="sec-mark"><span class="no">04</span><span>{h.insideLabel}</span></p>
    <div class="sec-body">
      <h2 class="h2" id="inside-h">{h.insideH2}</h2>
      <p class="lede">{h.insideText}</p>
      <div class="inside-fig"><LayersFigure lang={lang} /></div>
      <ul class="layers">
        {layers.map((l, i) => (
          <li>
            <span class="mono-line">{pad(i)}</span>
            <a href={`${pathFor(lang, 'products')}#${l.id}`} class="layer-name">{l.name}</a>
            <span class="layer-d">{c.products.layers[l.id].descriptor}</span>
            <Badge id={l.id} lang={lang} />
          </li>
        ))}
      </ul>
      <p><a class="quiet" href={pathFor(lang, 'products')}>{h.insideMore} <span aria-hidden="true">→</span></a></p>
    </div>
  </div>
</section>

<style>
.home-hero{border-bottom:1px solid var(--hair)}
.hero-grid{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:32px 56px;align-items:center;padding-top:48px;padding-bottom:56px}
.hero-text{display:flex;flex-direction:column;align-items:flex-start;gap:18px}
.home-hero .h1{font-size:clamp(36px,4.3vw,58px);max-width:18ch}
.home-hero .sub{margin:0;font-size:clamp(18px,1.6vw,20px);line-height:1.5;max-width:600px;color:var(--ink-2)}
.spec{margin:4px 0 6px;width:100%;max-width:620px;border-top:1px solid var(--hair)}
.spec div{display:grid;grid-template-columns:112px minmax(0,1fr);gap:12px;padding:9px 0;border-bottom:1px solid var(--line)}
.spec dt{font-family:var(--mono);font-size:11.5px;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);padding-top:3px}
.spec dd{margin:0;font-size:15.5px;line-height:1.5}
.spec .badge{margin-right:6px}

.acc{color:var(--accent)}
.get{list-style:none;margin:32px 0 40px;padding:0;border-top:1px solid var(--hair)}
.get li{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,6fr);gap:12px 40px;padding:24px 0;border-bottom:1px solid var(--line)}
.get-head{display:flex;flex-direction:column;gap:10px}
.get-head .h3{font-size:clamp(21px,2vw,26px)}
.get-body p{margin:0;font-size:16.5px;line-height:1.6;color:var(--ink-2)}
.get-body .example{margin-top:14px;padding:10px 0 0;border-top:1px dashed var(--line);font-size:15.5px;color:var(--ink)}
.get-body .example .label{display:block;margin-bottom:4px}

.flow{list-style:none;margin:40px 0 0;padding:0;border-top:1px solid var(--hair);counter-reset:f}
.flow li{display:grid;grid-template-columns:56px minmax(0,1fr) 200px;gap:8px 24px;padding:20px 0;border-bottom:1px solid var(--line)}
.flow-n{font-family:var(--mono);font-size:13px;color:var(--accent);padding-top:3px}
.flow p{margin:6px 0 0;font-size:16px;color:var(--ink-2);max-width:620px}
.flow-meta{margin:0;display:flex;flex-direction:column;gap:8px;align-items:flex-start}
.flow-meta div{display:flex;gap:8px;align-items:baseline}
.flow-meta dt{font-family:var(--mono);font-size:11px;text-transform:uppercase;letter-spacing:.09em;color:var(--muted)}
.flow-meta dd{margin:0;font-family:var(--mono);font-size:13px}
.today{margin:28px 0 0;padding:4px 0 4px 18px;border-left:3px solid var(--accent);font-size:16px;max-width:720px}

.doors{margin-top:36px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
.door{border:1px solid var(--hair);padding:24px 24px 28px;display:flex;flex-direction:column;align-items:flex-start;gap:12px}
.door-made{border-top:3px solid var(--accent)}
.door p:not(.label){margin:0;font-size:16px;color:var(--ink-2)}
.door p.door-status{font-family:var(--mono);font-size:12.5px;color:var(--ink);display:flex;flex-wrap:wrap;align-items:center;gap:6px 10px}
.door .btn,.door .quiet{margin-top:auto}

.inside-fig{margin:32px 0 8px}
.layers{list-style:none;margin:24px 0 20px;padding:0;border-top:1px solid var(--hair)}
.layers li{display:grid;grid-template-columns:40px 130px minmax(0,1fr) auto;gap:8px 20px;align-items:baseline;padding:14px 0;border-bottom:1px solid var(--line)}
.layer-name{font-family:var(--display);font-weight:700;font-size:22px;text-decoration:none}
.layer-d{font-size:15.5px;color:var(--ink-2)}

@media (max-width:1000px){
  .hero-grid{grid-template-columns:1fr}
  .get li{grid-template-columns:1fr}
}
@media (max-width:760px){
  .flow li{grid-template-columns:40px minmax(0,1fr)}
  .flow-meta{grid-column:2;flex-direction:row;flex-wrap:wrap;gap:8px 16px;align-items:center}
  .doors{grid-template-columns:1fr}
  .layers li{grid-template-columns:32px minmax(0,1fr) auto}
  .layer-d{grid-column:2 / -1}
}
@media (max-width:600px){
  .hero-grid{padding-top:32px;padding-bottom:40px}
  .spec div{grid-template-columns:1fr;gap:2px}
  .hero-cta{order:1}
  .spec{order:2}
  .home-hero .btn,.door .btn{flex:1 1 100%}
}
</style>
