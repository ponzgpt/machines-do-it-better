---
// The subscribe action: a plain link to Beehiiv's own page in a new tab. No form, embed or script, so the
// site never sees an email address and a visit makes no third-party request.
import { NEWSLETTER_SUBSCRIBE } from '../site';
import { copy, type Lang } from '../i18n';
interface Props { lang: Lang; label?: string; ghost?: boolean }
const { lang, label, ghost = false } = Astro.props;
const c = copy[lang];
---
<a class:list={['btn', ghost ? 'btn-ghost' : 'btn-ink']} href={NEWSLETTER_SUBSCRIBE} target="_blank" rel="noopener" data-subscribe>{label ?? c.letter.subscribe} <span aria-hidden="true">↗</span><span class="sr-only"> {c.newTab}</span></a>
