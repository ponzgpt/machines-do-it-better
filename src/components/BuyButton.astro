---
// Stripe Payment Links only: a plain link to Stripe's hosted checkout, in a new tab. No Stripe script, no embed.
// With stripeLink null (everything, today) the button is disabled and no price is shown. `access` swaps the
// "tell me" link for the access list (the bespoke private agent).
import { products } from '../catalog.mjs';
import { copy, pathFor, type Lang } from '../i18n';
import { NEWSLETTER_SUBSCRIBE } from '../site';
interface Props { id: string; lang: Lang; access?: boolean }
const { id, lang, access = false } = Astro.props;
const c = copy[lang];
const p = products.find((x) => x.id === id)!;
---
{p.stripeLink ? (
  <div class="row">
    {p.price && <span class="price">{p.price}</span>}
    <a class="btn btn-ink" href={p.stripeLink} target="_blank" rel="noopener">{c.products.buy} <span aria-hidden="true">↗</span><span class="sr-only"> {c.newTab}</span></a>
  </div>
) : (
  <div class="row">
    <span class="btn" aria-disabled="true">{c.products.notYet}</span>
    {access
      ? <a href={NEWSLETTER_SUBSCRIBE} target="_blank" rel="noopener">{c.letter.access} <span aria-hidden="true">↗</span><span class="sr-only"> {c.newTab}</span></a>
      : <a href={pathFor(lang, 'newsletter')}>{c.products.notify}</a>}
  </div>
)}
