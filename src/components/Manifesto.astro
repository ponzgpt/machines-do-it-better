---
// The manifesto: theses from mdib-ops strategy/business-thesis.md, distribution/SOUL.md and the positioning grill of
// 2026-11-14 (machines first, with its honest limits; only what is true today). Brand voice throughout, except the
// closing paragraph, the one place besides the footer where Javier Ponz appears.
import { copy, type Lang } from '../i18n';
import { OWNER_SITE } from '../site';
import NewsletterBlock from './NewsletterBlock.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const m = c.manifesto;
const pad = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="hero">
  <div class="wrap hero-in">
    <p class="eyebrow">{m.eyebrow}</p>
    <h1 class="h1">{m.h1}</h1>
    <p class="sub">{m.intro}</p>
  </div>
</section>

<section class="sec" aria-label={m.eyebrow}>
  <div class="wrap">
    <ol class="theses">
      {m.theses.map(([bold, text], i) => (
        <>
          <li>
            <span class="t-n" aria-hidden="true">{pad(i)}</span>
            <div><h2 class="h3">{bold}</h2><p>{text}</p></div>
          </li>
          {i === 2 && <li class="t-inline"><NewsletterBlock lang={lang} access inline={c.letter.inlineManifesto} /></li>}
        </>
      ))}
    </ol>
  </div>
</section>

<section class="sec" aria-labelledby="not-h">
  <div class="wrap sec-grid">
    <p class="sec-mark"><span class="no">×</span></p>
    <div class="sec-body">
      <h2 class="h2" id="not-h">{m.notH2}</h2>
      <ul class="not">{m.not.map((x) => <li>{x}</li>)}</ul>
    </div>
  </div>
</section>

<section class="sec" aria-labelledby="who-h">
  <div class="wrap sec-grid">
    <p class="sec-mark"><span class="no">—</span></p>
    <div class="sec-body">
      <h2 class="h2" id="who-h">{m.whoH2}</h2>
      <p class="lede">{m.who}</p>
      <p class="mono-line"><a href={OWNER_SITE} target="_blank" rel="noopener">{m.whoLink} <span aria-hidden="true">↗</span><span class="sr-only"> {c.newTab}</span></a></p>
    </div>
  </div>
</section>

<style>
.theses{list-style:none;margin:0;padding:0;border-top:1px solid var(--hair)}
.theses li{display:grid;grid-template-columns:minmax(0,3fr) minmax(0,9fr);gap:8px 48px;padding:28px 0;border-bottom:1px solid var(--line)}
.theses li.t-inline{display:block;padding:0;border-bottom:0}
.theses li.t-inline :global(.nl-inline){margin:0}
.t-n{font-family:var(--mono);font-size:13px;color:var(--accent);padding-top:4px}
.theses .h3{font-size:clamp(22px,2.2vw,28px)}
.theses p{margin:10px 0 0;font-size:17px;line-height:1.6;color:var(--ink-2);max-width:700px}
.not{margin:28px 0 0;padding:0;list-style:none;border-top:1px solid var(--hair)}
.not li{padding:14px 0 14px 30px;border-bottom:1px solid var(--line);font-size:17px;line-height:1.45;position:relative}
.not li::before{content:"×";position:absolute;left:4px;top:12px;font-family:var(--mono);font-size:18px;color:var(--accent)}
.sec-body .mono-line{margin-top:16px}
@media (max-width:900px){.theses li{grid-template-columns:1fr}}
</style>
