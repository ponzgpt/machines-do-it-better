---
// The manifesto: Javier's theses, from mdib-ops strategy/business-thesis.md, distribution/SOUL.md and the five
// pillars he set on 2026-11-14; the "will not do" list from scope-boundary.md and support-boundaries.md.
import { copy, pathFor, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const m = c.manifesto;
const pad = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="hero">
  <div class="wrap hero-in">
    <p class="eyebrow">{m.eyebrow}</p>
    <h1 class="h1 man-h1">{m.h1}</h1>
    <div class="rule" aria-hidden="true"></div>
    <p class="sub">{m.intro}</p>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <ol class="theses">
      {m.theses.map(([bold, text], i) => (
        <li>
          <span class="t-n" aria-hidden="true">{pad(i)}</span>
          <div><h2>{bold}</h2><p>{text}</p></div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="band tint" aria-labelledby="not-h">
  <div class="wrap two">
    <h2 class="h2" id="not-h">{m.notH2}</h2>
    <div>
      <ul class="not">{m.not.map((x) => <li>{x}</li>)}</ul>
      <p class="sign">{m.sign}</p>
      <div class="row">
        <a class="btn btn-ink" href={pathFor(lang, 'products')}>{c.home.ctaProducts} <span aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href={pathFor(lang, 'newsletter')}>{c.home.ctaNewsletter}</a>
      </div>
    </div>
  </div>
</section>

<style>
.man-h1{font-size:clamp(46px,7.4vw,104px);max-width:14ch}
.theses{list-style:none;margin:0;padding:0;border-top:2px solid var(--ink)}
.theses li{display:grid;grid-template-columns:160px minmax(0,1fr);gap:16px 40px;padding:40px 0;border-bottom:1px solid var(--line)}
.t-n{font-family:var(--display);font-weight:900;font-stretch:110%;font-size:clamp(48px,6vw,88px);line-height:.85;letter-spacing:-.05em;color:var(--accent)}
.theses h2{margin:0 0 12px;font-family:var(--display);font-weight:850;font-stretch:106%;font-size:clamp(28px,3.4vw,46px);line-height:1.02;letter-spacing:-.025em;max-width:22ch}
.theses p{margin:0;font-size:19px;line-height:1.55;color:var(--ink-2);max-width:680px}
.not{margin:0 0 32px;padding:0;list-style:none;border-top:2px solid var(--ink)}
.not li{padding:16px 0 16px 36px;border-bottom:1px solid var(--line);font-size:19px;line-height:1.45;position:relative}
.not li::before{content:"×";position:absolute;left:4px;top:13px;font-family:var(--display);font-weight:900;font-size:24px;color:var(--accent)}
.sign{margin:0 0 28px;font-family:var(--mono);font-size:14px;color:var(--muted)}
@media (max-width:700px){
  .theses li{grid-template-columns:1fr;padding:32px 0}
  .theses p,.not li{font-size:17px}
  .row .btn{flex:1 1 100%}
}
</style>
