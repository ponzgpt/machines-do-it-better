---
// The newsletter pop-up: a real <dialog>, closed in the markup, so with JavaScript off nothing appears.
// When and whether it opens is decided in src/scripts/newsletter-prompt.ts.
import { copy, type Lang } from '../i18n';
import SubscribeLink from './SubscribeLink.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang].letter;
---
<dialog class="nl-dialog" data-newsletter-dialog aria-labelledby="nl-dialog-h" aria-describedby="nl-dialog-p">
  <p class="eyebrow">{c.blockEyebrow}</p>
  <h2 id="nl-dialog-h">{c.dialogTitle}</h2>
  <p id="nl-dialog-p">{c.dialogText}</p>
  <div class="nl-actions">
    <SubscribeLink lang={lang} label={c.dialogYes} />
    <button type="button" class="btn btn-ghost" data-close>{c.dialogClose}</button>
  </div>
</dialog>
<script>
  import { mountNewsletterPrompt } from '../scripts/newsletter-prompt';
  mountNewsletterPrompt(document.querySelector<HTMLDialogElement>('[data-newsletter-dialog]'));
</script>
<style>
.nl-dialog{width:min(560px,calc(100vw - 32px));max-height:calc(100vh - 32px);padding:32px;border:2px solid var(--ink);border-top:10px solid var(--accent);background:var(--paper);color:var(--ink);box-shadow:12px 12px 0 var(--ink)}
.nl-dialog::backdrop{background:rgba(11,11,11,.55)}
.nl-dialog h2{margin:12px 0 12px;font-family:var(--display);font-weight:850;font-stretch:105%;font-size:clamp(28px,4vw,36px);line-height:1.05;letter-spacing:-.02em}
.nl-dialog p:not(.eyebrow){margin:0 0 24px;font-size:17px;color:var(--ink-2)}
.nl-actions{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media (max-width:480px){.nl-dialog{padding:24px 20px;box-shadow:6px 6px 0 var(--ink)}.nl-actions{grid-template-columns:1fr}}
@media (prefers-reduced-motion:no-preference){.nl-dialog[open]{animation:nl-in .18s ease-out}@keyframes nl-in{from{opacity:0;transform:translateY(8px)}}}
</style>
